rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Initial operator-owned directory; cooperative role provisioning follows.
    function directoryOwner(data) {
      return request.auth != null && data.createdBy == request.auth.uid;
    }
    function directoryBase(data) {
      return directoryOwner(data)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.village is string && data.village.size() >= 2 && data.village.size() <= 200
        && data.status == 'ACTIVE' && data.createdAt == request.time;
    }
    match /collectionCenters/{centerId} {
      allow read: if directoryOwner(resource.data);
      allow create: if directoryBase(request.resource.data)
        && request.resource.data.keys().hasAll(['name', 'village', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'village', 'status', 'createdBy', 'createdAt']);
      allow update, delete: if false;
    }
    match /farmers/{farmerId} {
      allow read: if directoryOwner(resource.data);
      allow create: if directoryBase(request.resource.data)
        && request.resource.data.keys().hasAll(['name', 'village', 'phone', 'centerId', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'village', 'phone', 'centerId', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[+]?[0-9][0-9 -]{5,18}[0-9]$')
        && request.resource.data.centerId is string
        && request.resource.data.centerId.matches('^[^/]+$')
        && exists(/databases/$(database)/documents/collectionCenters/$(request.resource.data.centerId))
        && get(/databases/$(database)/documents/collectionCenters/$(request.resource.data.centerId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/collectionCenters/$(request.resource.data.centerId)).data.status == 'ACTIVE';
      allow update, delete: if false;
    }

    match /collections/{collectionId} {
      function signedIn() {
        return request.auth != null;
      }

      function ownsExistingRecord() {
        return signedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      function validFields(data) {
        return data.keys().hasAll([
          'farmerName',
          'quantityLitres',
          'collectionDate',
          'createdAt',
          'createdBy'
        ])
        && data.keys().hasOnly([
          'farmerName',
          'quantityLitres',
          'collectionDate',
          'createdAt',
          'createdBy', 'fat', 'snf', 'temperature', 'qualityStatus',
          'farmerId', 'centerId', 'centerName', 'session', 'dayKey', 'notes', 'batchId'
        ])
        && data.farmerName is string
        && data.farmerName.size() >= 2
        && data.farmerName.size() <= 100
        && data.quantityLitres is number
        && data.quantityLitres > 0
        && data.createdBy is string
        && validQuality(data)
        && validLink(data);
      }

      function validQuality(data) {
        return (!data.keys().hasAny(['fat', 'snf', 'temperature', 'qualityStatus']))
          || (data.keys().hasAll(['fat', 'snf', 'temperature', 'qualityStatus'])
            && data.fat is number && data.fat >= 0 && data.fat <= 100
            && data.snf is number && data.snf >= 0 && data.snf <= 100
            && data.temperature is number && data.temperature >= 0
            && data.qualityStatus == ((data.fat >= 3 && data.snf >= 8 && data.temperature <= 10)
              ? 'ACCEPTED' : 'ALERT'));
      }

      function validLink(data) {
        return !data.keys().hasAny(['farmerId','centerId','centerName','session','dayKey','notes'])
          || (data.keys().hasAll(['farmerId','centerId','centerName','session','dayKey','notes'])
            && data.farmerId is string && data.centerId is string
            && data.session in ['MORNING','EVENING']
            && data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.notes is string && data.notes.size() <= 1000
            && get(/databases/$(database)/documents/farmers/$(data.farmerId)).data.createdBy == request.auth.uid
            && get(/databases/$(database)/documents/farmers/$(data.farmerId)).data.status == 'ACTIVE'
            && get(/databases/$(database)/documents/farmers/$(data.farmerId)).data.name == data.farmerName
            && get(/databases/$(database)/documents/farmers/$(data.farmerId)).data.centerId == data.centerId
            && get(/databases/$(database)/documents/collectionCenters/$(data.centerId)).data.createdBy == request.auth.uid
            && get(/databases/$(database)/documents/collectionCenters/$(data.centerId)).data.name == data.centerName
            && get(/databases/$(database)/documents/collectionCenters/$(data.centerId)).data.status == 'ACTIVE');
      }
      function assigningBatch() {
        let after = request.resource.data;
        let batch = getAfter(/databases/$(database)/documents/batches/$(after.batchId)).data;
        return !resource.data.keys().hasAny(['batchId'])
          && resource.data.keys().hasAll(['farmerId','centerId','dayKey','session'])
          && after.diff(resource.data).affectedKeys().hasOnly(['batchId'])
          && batch.createdBy == request.auth.uid && batch.status == 'PENDING'
          && batch.collectionIds.hasAny([collectionId])
          && batch.centerId == resource.data.centerId && batch.dayKey == resource.data.dayKey
          && batch.session == resource.data.session;
      }

      allow read: if ownsExistingRecord();

      allow create: if signedIn()
        && validFields(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['batchId'])
        && request.resource.data.collectionDate is timestamp
        && (request.resource.data.collectionDate == request.time
          || (request.resource.data.keys().hasAll(['farmerId'])
            && request.resource.data.collectionDate <= request.time + duration.value(1,'m')
            && request.resource.data.collectionDate >= timestamp.date(2020,1,1)))
        && request.resource.data.createdAt == request.time;

      // Registered source records are immutable except one-time batch assignment.
      allow update: if ownsExistingRecord() && (
        assigningBatch()
        || (!resource.data.keys().hasAny(['farmerId','batchId'])
          && validFields(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['farmerName','quantityLitres'])));
      allow delete: if ownsExistingRecord() && !resource.data.keys().hasAny(['farmerId','batchId']);

    }

    match /batches/{batchId} {
      function sourceMatches(data, i) {
        let id = data.collectionIds[i];
        let source = getAfter(/databases/$(database)/documents/collections/$(id)).data;
        return source.createdBy == request.auth.uid && source.batchId == batchId
          && source.centerId == data.centerId && source.session == data.session
          && source.dayKey == data.dayKey;
      }
      function optionalSource(data,i) {
        return data.collectionIds.size() <= i || sourceMatches(data,i);
      }
      allow read: if directoryOwner(resource.data);
      allow create: if directoryOwner(request.resource.data)
        && request.resource.data.keys().hasOnly(['createdBy','createdAt','collectionIds','centerId','session','dayKey','status'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'PENDING'
        && request.resource.data.collectionIds is list
        && request.resource.data.collectionIds.size() >= 1
        && request.resource.data.collectionIds.size() <= 8
        && request.resource.data.collectionIds.toSet().size() == request.resource.data.collectionIds.size()
        && sourceMatches(request.resource.data,0)
        && optionalSource(request.resource.data,1) && optionalSource(request.resource.data,2)
        && optionalSource(request.resource.data,3) && optionalSource(request.resource.data,4)
        && optionalSource(request.resource.data,5) && optionalSource(request.resource.data,6)
        && optionalSource(request.resource.data,7);
      allow update: if directoryOwner(resource.data) && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','testNotes','testedBy','testedAt'])
        && request.resource.data.status in ['PASSED','FAILED']
        && request.resource.data.testNotes is string
        && request.resource.data.testNotes.size() >= 3 && request.resource.data.testNotes.size() <= 1000
        && request.resource.data.testedBy == request.auth.uid && request.resource.data.testedAt == request.time;
      allow delete: if false;
    }
    match /disputes/{disputeId} {
      allow read: if directoryOwner(resource.data);
      allow create: if directoryOwner(request.resource.data)
        && request.resource.data.keys().hasOnly(['collectionId','type','description','status','createdBy','createdAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'OPEN'
        && request.resource.data.type in ['Quantity','Quality','Other']
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5 && request.resource.data.description.size() <= 1000
        && get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.createdBy == request.auth.uid;
      allow update: if directoryOwner(resource.data)
        && resource.data.status in ['OPEN','UNDER_REVIEW']
        && request.resource.data.status in ['UNDER_REVIEW','RESOLVED','REJECTED']
        && resource.data.status != request.resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','reviewedBy','reviewedAt'])
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() >= 3 && request.resource.data.resolution.size() <= 1000
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
  }
}
